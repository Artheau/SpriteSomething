{
  "$schema": "../../../../../schema/png-layout.schema.json",
  "comment": [
    "This file in some cases has a very specific ordering.  For instance, the first instance of any used_by list",
    "will also be the pose that is used to import the image.  For this reason, some poses will be out of order",
    "and this is intentional because a pose might be mirrored in its first occurance (grapple), or perhaps",
    "the way that it will be present in the ROM is different before and after modification (e.g. screw attack)"
  ],
  "border_color": [217, 87, 99, 255],
  "border_size": 0,
  "layout": [
    [
      "run1Head",
      "run2Head",
      "null_block",
      "run3Head",
      "jumpLegs",
      "facingHead",
      "null_block",
      "explodingHead",
      "idleHead",
      "null_block"
    ],
    [
      "null_block4",
      "null_block4",
      "null_block",
      "facingShoulders",
      "explodingShoulders",
      "idleShoulders",
      "idleWeapon"
    ],
    [
      "run1Torso",
      "run2Torso",
      "null_block",
      "run3Torso",
      "null_block",
      "facingTorso",
      "explodingTorso",
      "idleTorso",
      "null_block"
    ],
    [
      "null_block",
      "run1BackLeg",
      "run2Legs",
      "run3Legs",
      "null_block2",
      "facingLeg",
      "null_block",
      "idleLegs",
      "null_block3"
    ],
    [
      "run1Shoulders",
      "run2Shoulders",
      "run3Shoulders",
      "null_block3",
      "firingTorso",
      "null_block4"
    ],
    [
      "morphBallTop",
      "spinJump1Top",
      "spinJump2Top",
      "null_block4",
      "null_block4",
      "null_block"
    ],
    [
      "morphBallBottom",
      "spinJump1Middle",
      "spinJump2Bottom",
      "null_block2",
      "pointUpWeapon",
      "null_block4",
      "null_block2"
    ],
    [
      "null_block2",
      "spinJump1Bottom",
      "null_block3",
      "pointUpShoulders",
      "pointUpHead",
      "null_block4",
      "palette_block"
    ]
  ],
  "images": {
    "1TilePattern":       { "dimensions": [0,0, 8,8], "import palette interval": [0,4] },
    "2TilePattern":       { "dimensions": [0,0,16,8], "import palette interval": [0,4] },
    "3TilePattern":       { "dimensions": [0,0,24,8], "import palette interval": [0,4] },

    "run1Head":           { "parent": "2TilePattern" },
    "run2Head":           { "parent": "2TilePattern" },
    "run3Head":           { "parent": "2TilePattern" },
    "jumpLegs":           { "parent": "2TilePattern" },
    "facingHead":         { "parent": "1TilePattern" },
    "explodingHead":      { "parent": "2TilePattern" },
    "idleHead":           { "parent": "2TilePattern" },
    "idleWeapon":         { "parent": "1TilePattern" },

    "facingShoulders":    { "parent": "2TilePattern" },
    "explodingShoulders": { "parent": "2TilePattern" },
    "idleShoulders":      { "parent": "2TilePattern" },
    "run1Torso":          { "parent": "2TilePattern" },
    "run2Torso":          { "parent": "2TilePattern" },
    "run3Torso":          { "parent": "3TilePattern" },
    "facingTorso":        { "parent": "2TilePattern" },
    "explodingTorso":     { "parent": "2TilePattern" },
    "idleTorso":          { "parent": "2TilePattern" },

    "run1BackLeg":        { "parent": "1TilePattern" },
    "run2Legs":           { "parent": "3TilePattern" },
    "run3Legs":           { "parent": "2TilePattern" },
    "facingLeg":          { "parent": "1TilePattern" },
    "idleLegs":           { "parent": "2TilePattern" },

    "run1Shoulders":      { "parent": "2TilePattern" },
    "run2Shoulders":      { "parent": "2TilePattern" },
    "run3Shoulders":      { "parent": "2TilePattern" },
    "firingTorso":        { "parent": "3TilePattern" },
    "morphBallTop":       { "parent": "2TilePattern" },
    "spinJump1Top":       { "parent": "2TilePattern" },
    "spinJump2Top":       { "parent": "3TilePattern" },

    "morphBallBottom":    { "parent": "2TilePattern" },
    "spinJump1Middle":    { "parent": "2TilePattern" },
    "spinJump2Bottom":    { "parent": "3TilePattern" },
    "pointUpWeapon":      { "parent": "1TilePattern" },

    "spinJump1Bottom":    { "parent": "2TilePattern" },
    "pointUpShoulders":   { "parent": "2TilePattern" },
    "pointUpHead":        { "parent": "2TilePattern" },

    "null_block":         { "parent": "1TilePattern" },
    "null_block2":        { "parent": "2TilePattern" },
    "null_block3":        { "parent": "3TilePattern" },
    "null_block4":        { "dimensions": [0,0,32,8] },

    "palette_block":      { "dimensions": [0,0,8,8] }
  }
}
