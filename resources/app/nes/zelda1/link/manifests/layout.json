{
  "$schema": "../../../../../schema/png-layout.schema.json",
  "comment": [
    "This file in some cases has a very specific ordering.  For instance, the first instance of any used_by list",
    "will also be the pose that is used to import the image.  For this reason, some poses will be out of order",
    "and this is intentional because a pose might be mirrored in its first occurance (grapple), or perhaps",
    "the way that it will be present in the ROM is different before and after modification (e.g. screw attack)"
  ],
  "border_color": [217, 87, 99, 255],
  "border_size": 0,
  "layout": [
    [
      "walk1Profile",
      "walk2Profile",
      "facingDownNoShield",
      "facingUp",
      "attackingProfile",
      "attackingDown",
      "attackingUp"
    ],
    [
      "facingDownBigshield",
      "walk1ProfileBigshield",
      "walk2ProfileBigshield",
      "walk1DownSmallshield",
      "walk2DownSmallshield",
      "liftingItem",
      "null_block",
      "palette_block"
    ]
  ],
  "pseudoimages": [
    "tfp_gold",
    "pop_big",
    "transparent",
    "pop_small",
    "tfp_blue"
  ],
  "images": {
    "liftingItem":            { "dimensions": [0,0,8,16], "import palette interval": [1,4] },

    "walk1ProfileBigshield":  { "dimensions": [0,0,8,16], "import palette interval": [1,4] },

    "walk1Profile":           { "dimensions": [0,0,16,16], "import palette interval": [1,4] },
    "walk2Profile":           { "parent": "walk1Profile" },
    "facingDownNoShield":     { "dimensions": [0,0,16,16], "import palette interval": [1,4] },
    "facingUp":               { "dimensions": [0,0,16,16], "import palette interval": [1,4] },
    "attackingProfile":       { "dimensions": [0,0,16,16], "import palette interval": [1,4] },
    "attackingDown":          { "dimensions": [0,0,16,16], "import palette interval": [1,4] },
    "attackingUp":            { "dimensions": [0,0,16,16], "import palette interval": [1,4] },

    "walk2ProfileBigshield":  { "parent": "walk1ProfileBigshield" },
    "walk1DownSmallshield":   { "dimensions": [0,0,8,16], "import palette interval": [1,4] },
    "walk2DownSmallshield":   { "parent": "walk1DownSmallshield" },
    "facingDownBigshield":    { "dimensions": [0,0,8,16], "import palette interval": [1,4] },

    "null_block":       { "dimensions": [0,0,56,16] },
    "palette_block":    { "dimensions": [0,0,8,8], "shift": [0,8] }
  }
}
